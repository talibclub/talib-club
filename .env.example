VITE_WEB_FIREBASE_API_KEY="your-api-key-here"
VITE_WEB_FIREBASE_AUTH_DOMAIN="your-auth-domain"
VITE_WEB_FIREBASE_PROJECT_ID="your-project-id"
VITE_WEB_FIREBASE_STORAGE_BUCKET="your-storage-bucket"
VITE_WEB_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_WEB_FIREBASE_APP_ID="your-app-id"
VITE_WEB_FIREBASE_MEASUREMENT_ID="your-measurement-id"
# Required by Vercel API routes that use Firebase Admin. Store the complete
# service-account JSON in Vercel as one escaped JSON string; never use VITE_.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id"}'
OPENAI_API_KEY="sk-your-openai-key"
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"
ANTHROPIC_MODEL="claude-3-5-sonnet-20240620"
GEMINI_API_KEY="your-gemini-key"
GEMINI_MODEL="gemini-1.5-flash"


# Staff Work — แจ้งเตือน Telegram (ไม่ใส่ = ปิดการแจ้งเตือน)
# DO NOT use VITE_ prefix for these to prevent leaking into client bundle
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"
TELEGRAM_TOPIC_ID=""

# Google Drive storage. Server-only: never prefix these with VITE_.
# Run scripts/connect-google-drive.mjs as documented in docs/google-drive-storage.md.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""
# Leave false until all existing notebooks have been migrated or confirmed absent.
GOOGLE_DRIVE_LEGACY_NOTEBOOKS_MIGRATED="false"
ALLOWED_ORIGIN="https://talibclub.org"

# Tracking administration uses authenticated staff accounts only. Do not expose a password with a VITE_ prefix.

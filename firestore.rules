rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["staff", "admin", "owner"];
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "owner"];
    }

    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    function isOwnerOrAdmin() {
      return isAdmin();
    }

    function isSignedInUser(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    function ownsExistingDocument() {
      // `resource.data.get('uid', request.auth.uid)` defaulted a MISSING uid
      // field to the caller's own uid, so any document that happened to have no
      // uid could be updated or deleted by any signed-in user — on collections
      // whose read rule they could not even pass. `resource == null` was dead
      // too: update and delete only ever run on a document that exists.
      // Every create rule here already forces uid == request.auth.uid, so a
      // document without one was never made through the app.
      return signedIn() && resource != null && resource.data.uid == request.auth.uid;
    }

    function keepsOwnership() {
      return request.resource.data.uid == request.auth.uid;
    }

    // --- Users Collection Rules ---
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());
      allow create: if signedIn() 
        && request.auth.uid == userId
        && (!("role" in request.resource.data) || request.resource.data.role == "member");
      allow update: if isOwnerOrAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])));
      allow delete: if isOwner();
    }

    // --- System Analytics Collections ---
    match /site_visits/{docId} {
      allow read: if isStaff();
      // Guests must still be countable (uid: "unknown"), so creation stays open
      // — but lock the shape and sizes so bots can't dump arbitrary payloads.
      allow create: if request.resource.data.keys().hasOnly(["createdAt", "userAgent", "path", "uid", "displayName", "email"])
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() < 512
        && request.resource.data.path is string && request.resource.data.path.size() < 256
        && request.resource.data.uid is string && request.resource.data.uid.size() < 128
        && request.resource.data.displayName is string && request.resource.data.displayName.size() < 256
        && request.resource.data.email is string && request.resource.data.email.size() < 256;
    }

    // --- Public Content Collections ---

    // Engagement counters (views / downloads / shares) are bumped from the
    // browser by utils/contentMetrics.js on a plain visitor's page view. The
    // old `allow write: if isStaff()` denied every one of those writes, so the
    // numbers only ever moved when a staff member happened to open the page —
    // and every other visitor got a permission error in the console.
    //
    // Rather than opening the documents up, the rule proves the exact shape of
    // an increment(1): one counter field touched, and its new value is exactly
    // the old value plus one. A visitor can therefore add one to a counter and
    // nothing else — they cannot edit the article, and cannot set a counter to
    // an arbitrary total. Guests are allowed for the same reason site_visits
    // allows them: most reads of a public article are not signed in.
    function bumpsCounter(field) {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] is int
        && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    function isCounterBump() {
      return bumpsCounter('views') || bumpsCounter('downloads') || bumpsCounter('shares');
    }

    match /content_articles/{docId} {
      allow read: if true;
      allow update: if isStaff() || isCounterBump();
      allow create, delete: if isStaff();
    }

    match /content_books/{docId} {
      allow read: if true;
      allow update: if isStaff() || isCounterBump();
      allow create, delete: if isStaff();
    }

    match /content_media/{docId} {
      allow read: if true;
      allow update: if isStaff() || isCounterBump();
      allow create, delete: if isStaff();
    }

    match /content_scholars/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /content_settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // --- User-Specific Content Collections ---
    match /content_bookmarks/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if ownsExistingDocument() && keepsOwnership();
      allow delete: if ownsExistingDocument();
    }

    match /content_notebooks/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if ownsExistingDocument() && keepsOwnership();
      allow delete: if ownsExistingDocument();
    }

    match /content_bookshelf/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if ownsExistingDocument() && keepsOwnership();
      allow delete: if ownsExistingDocument();
    }

    match /content_reading_sessions/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if ownsExistingDocument() && keepsOwnership();
      allow delete: if ownsExistingDocument();
    }

    match /content_reading_streaks/{docId} {
      allow read: if signedIn() && (docId == request.auth.uid || isStaff());
      allow create, update: if signedIn() && docId == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && docId == request.auth.uid;
    }

    // Public half of a member's streak, mirrored from content_reading_streaks so
    // LeaderboardPanel has something it is actually allowed to list. The streaks
    // document itself must stay owner-only — it also carries gems, freeze/leave
    // credits and claimedMissions — so the leaderboard's
    // `orderBy(streakCount).limit(10)` query was rejected for every member and
    // the board rendered empty (staff saw it work, which is why it looked fine).
    // Only the three numbers the board prints live here, and each member may
    // write only their own row.
    match /leaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if isSignedInUser(userId)
        && request.resource.data.keys().hasOnly(["uid", "displayName", "streakCount", "bestStreak", "updatedAt"])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.streakCount is int
        && request.resource.data.bestStreak is int;
      allow delete: if isSignedInUser(userId) || isAdmin();
    }

    match /content_quran_bookmarks/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if ownsExistingDocument() && keepsOwnership();
      allow delete: if ownsExistingDocument();
    }

    match /content_quran_last_read/{docId} {
      allow read: if signedIn() && (docId == request.auth.uid + "_last_read" || isStaff());
      allow create, update: if signedIn() && docId == request.auth.uid + "_last_read" && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && docId == request.auth.uid + "_last_read";
    }

    match /content_history/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if ownsExistingDocument() && keepsOwnership();
      allow delete: if ownsExistingDocument();
    }

    // --- Push Notification Subscriptions (C3: was missing) ---
    match /push_subscriptions/{docId} {
      allow read: if isStaff();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["subscription", "endpoint", "uid", "userId", "isStaff", "updatedAt"]);
      allow update: if ownsExistingDocument() && keepsOwnership();
      allow delete: if ownsExistingDocument();
    }

    // --- Staff Portal Collections ---
    match /system/{docId} {
      allow read, write: if isStaff();
    }

    match /counters/{docId} {
      allow read, write: if isStaff();
    }

    match /submissions/{docId} {
      allow read, write: if isStaff();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /translation_abuiyaad/{docId} {
      allow read, write: if isStaff();
    }

    // --- Logistics Tracking Collections ---
    // Member search goes through /api/track-lookup (firebase-admin) which does
    // exact-match only and trims fields. Rules cannot enforce a `where` clause,
    // so any client-side list access here would leak other people's PII.
    match /records/{docId} {
      allow read, write: if isStaff();
    }

    match /recipients/{docId} {
      allow read, write: if isStaff();
    }

    match /staff_tasks/{docId} {
      allow read, write: if isStaff();
    }

    match /content_calendar/{docId} {
      allow read, write: if isStaff();
    }

    match /openhouse_booths/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /book_campaigns/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /book_campaigns/{campaignId}/holds/{holdId} {
      allow read, write: if isStaff();
    }

    match /book_registrations/{docId} {
      allow create: if isStaff();
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow list: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // หมายเหตุสำคัญ: Firebase rules ใช้ OR semantics — ถ้ามี match block ใดตรง
    // path แล้ว allow เป็น true จะผ่านทันที ดังนั้น "ห้าม" มี catch-all
    // /{allPaths=**} ที่ allow read: if true อีก เพราะมันจะทับกฎ private ของ
    // slips/ และ notebooks/ ทั้งหมด (บั๊กเดิม: สลิปโอนเงินและสมุดโน้ต
    // อ่านได้โดยไม่ต้อง login)

    function isStaff() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          in ["staff", "admin", "owner"];
    }

    // 1. สลิปโอนเงิน — ส่วนตัว: เจ้าของหรือทีมงานเท่านั้น
    match /slips/{fileName} {
      allow read: if request.auth != null && (
        fileName.matches(request.auth.uid + '.*') ||
        isStaff()
      );
      allow create: if request.auth != null
                    && fileName.matches(request.auth.uid + '.*')
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // 2. สมุดโน้ต — เฉพาะเจ้าของ
    match /notebooks/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. เสียงอัดของผู้ใช้ — เฉพาะเจ้าของ (playback ใช้ token URL อยู่แล้ว)
    match /user_audio/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. ไฟล์หนังสือที่สมาชิกอัปโหลดเข้าชั้นของตัวเอง (ReadingApp.addExternalBook)
    //    เดิมไม่มี match block นี้ — Storage จึง deny by default และปุ่ม
    //    "อัปโหลดไฟล์" ในห้องอ่านหนังสือล้มเหลวทุกครั้ง เหลือแต่การวางลิงก์
    match /members/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // เดิมมี /notebook_audios/{fileName} ที่ allow read ให้สมาชิกที่ล็อกอินทุกคน
    // (อ่านไฟล์เสียงของคนอื่นได้ถ้ารู้ชื่อไฟล์) กฎนั้นเขียนไว้ให้
    // components/AudioShapeUtil.jsx ซึ่งเป็นซากของสมุดโน้ตเวอร์ชัน tldraw และถูก
    // ลบไปแล้ว — ระบบเสียงที่ใช้จริงเก็บที่ /user_audio/{uid}/ ตามกฎข้อ 3

    // 5. ไฟล์งานทีม — ทีมงานเท่านั้น
    match /staff_submissions/{allPaths=**} {
      allow read, write: if isStaff();
    }
    match /staff_tasks/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // 6. Asset สาธารณะ (รูปปก ฯลฯ) — ใครดูก็ได้ ทีมงานอัปโหลด
    match /article_covers/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /library_covers/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /campaign_images/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ไฟล์เก่าใน prefix อื่น: รูปที่เว็บแสดงใช้ download URL แบบมี token ซึ่ง
    // ไม่ผ่าน rules อยู่แล้ว จึงยังแสดงผลได้ตามปกติแม้ไม่มี catch-all read
  }
}
